Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 501
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.4000000059604645
    Cell Size: 5
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 60
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
      base_footprint:
        Value: true
      map:
        Value: true
      odom:
        Value: true
    Marker Scale: 2
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Tree:
      map:
        odom:
          base_footprint: {}
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: false
    Name: Sim world (track + clutter, truth)
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/debug/world
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Enabled: false
    Name: Sim car (truth; green = ECU enabled)
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/debug/car
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Live cones (what perception emits)
    Namespaces:
      live: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/debug/live_cones
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: SLAM map (cones + graph)
    Namespaces:
      big_orange_landmarks: true
      blue_landmarks: true
      unknown_landmarks: true
      yellow_landmarks: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /localization/debug/markers
    Value: true
  - Angle Tolerance: 0.10000000149011612
    Class: rviz_default_plugins/Odometry
    Covariance:
      Orientation:
        Alpha: 0.5
        Color: 255; 255; 127
        Color Style: Unique
        Frame: Local
        Offset: 1
        Scale: 1
        Value: true
      Position:
        Alpha: 0.30000001192092896
        Color: 204; 51; 204
        Scale: 1
        Value: true
      Value: false
    Enabled: true
    Keep: 1
    Name: Ego odometry (SLAM)
    Position Tolerance: 0.10000000149011612
    Shape:
      Alpha: 1
      Axes Length: 1
      Axes Radius: 0.10000000149011612
      Color: 255; 25; 0
      Head Length: 0.30000001192092896
      Head Radius: 0.20000000298023224
      Shaft Length: 1
      Shaft Radius: 0.07999999821186066
      Value: Arrow
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /localization/ego_odom
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 25; 255; 0
    Enabled: true
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Lines
    Line Width: 0.029999999329447746
    Name: Global raceline
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /planning/global_path_waypoints/path
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 170; 255
    Enabled: true
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Lines
    Line Width: 0.029999999329447746
    Name: Local path
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /planning/local_waypoints/path
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 255; 255; 0
    Enabled: true
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Lines
    Line Width: 0.05000000074505806
    Name: Selected path (controller)
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /planning/debug/path
    Value: true
  - Align Bottom: false
    Background Alpha: 0.800000011920929
    Background Color: 0; 0; 0
    Class: rviz_2d_overlay_plugins/TextOverlay
    Enabled: true
    Foreground Alpha: 0.800000011920929
    Foreground Color: 25; 255; 240
    Invert Shadow: false
    Name: Stack HUD
    Overtake BG Color Properties: false
    Overtake FG Color Properties: false
    Overtake Position Properties: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /planning/stack_hud
    Value: true
    font: DejaVu Sans Mono
    height: 128
    hor_alignment: left
    hor_dist: 0
    line width: 2
    text size: 12
    ver_alignment: top
    ver_dist: 0
    width: 128
  - Class: rviz_2d_overlay_plugins/TextOverlay
    Enabled: true
    Name: Sensor HUD
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sensors/hud
    Value: true
  - Class: rviz_2d_overlay_plugins/TextOverlay
    Enabled: true
    Name: Control Plot
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /planning/control_plot
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 10.725606918334961
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 1.3904976844787598
      Y: -2.2703702449798584
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 1136
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1850
  X: 70
  Y: 27
