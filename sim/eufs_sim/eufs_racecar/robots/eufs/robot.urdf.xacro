<?xml version="1.0"?>
<robot name="eufs" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ***************** -->
    <!-- Config parameters -->
    <!-- ***************** -->

    <!--  Load the config file  -->
    <xacro:property name="config" value="${xacro.load_yaml('$(arg config_file)')}"/>

    <!-- ***************** -->
    <!-- Global parameters -->
    <!-- ***************** -->

    <xacro:property name="PI" value="3.1415926535897931"/>

    <!-- If the gazebo_ros_race_car_model should publish the ground truth tf -->
    <xacro:arg name="publish_tf" default="false"/>
    <!-- If the perception stack should be simulated or if sensors should be used -->
    <xacro:arg name="simulate_perception" default="true"/>

    <!-- ***************** -->
    <!-- Imported elements -->
    <!-- ***************** -->

    <!--  Import the wheels  -->
    <xacro:include filename="$(find eufs_racecar)/urdf/wheels.urdf.xacro"/>

    <!-- Import EUFS base element with the chassis -->
    <xacro:include filename="$(find eufs_racecar)/urdf/eufs_base.urdf.xacro" />

    <!-- Import all available sensors -->
    <xacro:include filename="$(find eufs_sensors)/urdf/all_sensors.urdf.xacro" />

    <!--  Include the plugins  -->
    <xacro:include filename="$(find eufs_plugins)/urdf/eufs_plugins.gazebo.xacro" />

    <!-- *************** -->
    <!-- Robots Elements -->
    <!-- *************** -->

    <!-- Chassis of the car -->
    <xacro:eufs_base chassis_mesh="file://$(find eufs_racecar)/meshes/sisu-20d.dae"/>

    <!-- Wheels -->
    <xacro:wheels chassis_width="1.6" wheelbase="1.580"/>

    <!-- *********************************************** -->
    <!--                 MAIN SENSORS                    -->
    <!-- *********************************************** -->

    <!--     LOCATIONS: (XYZ)
    IMU: 0.0 0.0 0.170
    LIDAR: 1.700 0.0 -0.150
    STEREO CAM: -0.110 0.0 0.800 -->

    <xacro:sensor_imu parent="chassis" prefix="sbg_imu" topic_prefix="">
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:sensor_imu>

    <!-- No gazebo GPS or magnetometer. Nothing in the stack consumed either
         topic, and the GNSS/INS path is simulated at the driver level by
         sim_ellipse_d (/sbg/ekf_nav + /sbg/ekf_euler), where the Ellipse-D
         error model actually lives. A raw 2 m-white-noise NavSatFix next to
         a cm-level RTK model was only there to mislead. -->


    <!-- Real car: VLP-16 (16 channels) mounted on the nose cone. hz is the only
         knob; the macro derives horizontal resolution from it the way the
         hardware does (10 Hz -> 0.2 deg).

         The sensor emits the geometrically ideal scan on _ideal; the
         lidar_realism bridge (spawned by load_car.launch.py) owns
         /velodyne_points, adding motion distortion, far-ground dropout and
         the real driver's ring/time field layout. Its spin_hz must match
         hz here. -->
    <xacro:VLP-16R parent="chassis" name="velodyne" topic="/velodyne_points_ideal" hz="10" active="$(arg simulate_perception)">
        <origin xyz="1.6 0.0 0.25" rpy="0 ${1*M_PI/180.0} 0"/>
        <!-- main-hoop mount (previous): <origin xyz="-0.15 0.0 0.79" rpy="0 ${1*M_PI/180.0} 0"/> -->
    </xacro:VLP-16R>

    <xacro:zed_camera parent="chassis" prefix="zed" active="$(arg simulate_perception)">
        <origin xyz="-0.08 0.0 0.76" rpy="0 0 0"/>
    </xacro:zed_camera>

    <!-- No zed_imu: the ZED's built-in IMU is not used by the stack, and its
         simulated stream (/camera/imu/data) had zero subscribers. -->

</robot>
