<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyu_planning_bringup</name>
  <version>0.1.0</version>
  <description>Integrated local and global planning launch composition.</description>
  <maintainer email="maintainer@example.com">fsk</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>hyu_localization</exec_depend>
  <exec_depend>hyu_global_planner</exec_depend>
  <exec_depend>hyu_frenet_conversion</exec_depend>
  <exec_depend>hyu_state_machine</exec_depend>
  <exec_depend>hyu_local_planner</exec_depend>
  <exec_depend>hyu_path_selector</exec_depend>
  <exec_depend>hyu_pure_pursuit</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>hyu_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>rviz_2d_overlay_msgs</exec_depend>
  <!-- hyu_tmpc is deliberately NOT declared here. It is only reachable through
       launch/tmpc_trackdrive.launch.py, which stack.sh has retired ("the MAP
       controller drives"), and it vendors a prebuilt x86-64 libosqp.a that
       cannot link on the vehicle's arm64 compute. As a hard exec_depend it
       made an unbuildable package block the entire planning graph on the car.
       The bridges below DO build everywhere, so they stay. -->
  <exec_depend>hyu_tmpc_state_bridge</exec_depend>
  <exec_depend>hyu_tmpc_output_bridge</exec_depend>
  <exec_depend>hyu_cmd_selector</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
