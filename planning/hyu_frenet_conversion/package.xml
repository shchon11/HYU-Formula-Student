<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyu_frenet_conversion</name>
  <version>0.0.1</version>
  <description>
    Converts /global_waypoints (hyu_msgs/WaypointArrayStamped) and vehicle
    odometry into Frenet (s, d) coordinates using the CommonRoad curvilinear
    coordinate system, publishing /car_state/frenet/odom for Formula Student
    Korea autonomous planning.
  </description>
  <maintainer email="parkm04@hanyang.ac.kr">haejun</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hyu_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- System libraries pulled in by the CommonRoad-CLCS core -->
  <depend>eigen</depend>
  <depend>boost</depend>

  <!--
    Not managed by rosdep and located via CMake instead:
      * CommonRoad-CLCS  -> set COMMONROAD_CLCS_DIR (cmake cache / env var)
      * spdlog           -> find_package(spdlog)  (system libspdlog-dev)
      * OpenMP           -> compiler-provided
  -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
