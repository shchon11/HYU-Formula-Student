<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsk_rviz_presets</name>
  <version>0.1.0</version>
  <description>
    One-click RViz display groups (Perception / SLAM / Planning / HUD) for the
    HYU Formula Student autonomous stack.
  </description>
  <maintainer email="shchon724@gmail.com">SeongHyun</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rviz_common</depend>

  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>rviz_2d_overlay_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
