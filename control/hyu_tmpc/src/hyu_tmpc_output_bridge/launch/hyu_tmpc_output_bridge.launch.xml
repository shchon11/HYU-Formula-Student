<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="input_topic" default="/output"/>
  <arg name="output_topic" default="/tmpc/cmd_shadow"/>
  <arg name="valid_topic" default="/tmpc/cmd_valid"/>
  <arg name="conversion_mass_kg" default="225.0"/>
  <arg name="steering_min_rad" default="-0.52"/>
  <arg name="steering_max_rad" default="0.52"/>
  <arg name="acceleration_min_mps2" default="-10.0"/>
  <arg name="acceleration_max_mps2" default="3.0"/>
  <arg name="safe_brake_mps2" default="-5.0"/>
  <arg name="output_timeout_sec" default="0.1"/>
  <arg name="publish_rate_hz" default="100.0"/>

  <node pkg="hyu_tmpc_output_bridge" exec="hyu_tmpc_output_bridge"
        name="hyu_tmpc_output_bridge" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="hyu_tmpc_output_bridge/input_topic" value="$(var input_topic)"/>
    <param name="hyu_tmpc_output_bridge/output_topic" value="$(var output_topic)"/>
    <param name="hyu_tmpc_output_bridge/valid_topic" value="$(var valid_topic)"/>
    <param name="hyu_tmpc_output_bridge/conversion_mass_kg" value="$(var conversion_mass_kg)"/>
    <param name="hyu_tmpc_output_bridge/steering_min_rad" value="$(var steering_min_rad)"/>
    <param name="hyu_tmpc_output_bridge/steering_max_rad" value="$(var steering_max_rad)"/>
    <param name="hyu_tmpc_output_bridge/acceleration_min_mps2" value="$(var acceleration_min_mps2)"/>
    <param name="hyu_tmpc_output_bridge/acceleration_max_mps2" value="$(var acceleration_max_mps2)"/>
    <param name="hyu_tmpc_output_bridge/safe_brake_mps2" value="$(var safe_brake_mps2)"/>
    <param name="hyu_tmpc_output_bridge/output_timeout_sec" value="$(var output_timeout_sec)"/>
    <param name="hyu_tmpc_output_bridge/publish_rate_hz" value="$(var publish_rate_hz)"/>
  </node>
</launch>
