# fsk-shellrc — HYU Formula Student shell setup (bash & zsh).
#
# Install (one line in ~/.bashrc or ~/.zshrc):
#   source <path-to-workspace>/src/scripts/fsk-shellrc
#
# Everything below self-locates from this file's position, so the workspace
# can live anywhere (~/fsk, ~/work/fsk, ...). Override any of the exports
# BEFORE the source line if your layout differs.

# --- locate the workspace (works when sourced from bash or zsh) -------------
if [ -n "$ZSH_VERSION" ]; then
  _fsk_this="${(%):-%N}"
  _fsk_ext=zsh
else
  _fsk_this="${BASH_SOURCE[0]}"
  _fsk_ext=bash
fi
_fsk_src_dir="$(cd -- "$(dirname -- "$_fsk_this")/.." && pwd)"       # .../src
export EUFS_MASTER="${EUFS_MASTER:-$(cd "$_fsk_src_dir/.." && pwd)}" # workspace root

# --- environment -------------------------------------------------------------
export COMMONROAD_CLCS_DIR="${COMMONROAD_CLCS_DIR:-$HOME/commonroad-clcs}"
# ROS_LOCALHOST_ONLY=1 (loopback-only) DDS discovery needs the MULTICAST flag on
# `lo`. Some hosts ship lo without it, and then =1 silently kills cross-process
# discovery — `ros2 topic list` shows only /rosout and every `race` pane hangs
# on "waiting for car". Detect it: keep =1 (isolated) when lo has MULTICAST,
# else fall back to =0 (real interfaces, which do carry multicast).
if ip link show lo 2>/dev/null | grep -q "MULTICAST"; then
  export ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-1}"
else
  export ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}"
fi

# --- CPU thread caps ---------------------------------------------------------
# This stack runs many ROS nodes at once, and numpy/scipy/sklearn (perception
# cone clustering) plus g2o each default their OpenMP/BLAS pools to the FULL
# core count. On a many-core box those pools oversubscribe and thrash: on a
# 16-core laptop perception_node alone hit ~900% CPU (real parallel work, not
# spin — a bigger core count just spawns a bigger team), starving gzserver so
# the car "won't spawn" and the sim stalls. A single frame's DBSCAN/plane-fit
# needs only a few threads. Override before sourcing if you really want more.
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export OMP_WAIT_POLICY="${OMP_WAIT_POLICY:-passive}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-4}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-4}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-4}"

# --- GPU render offload (hybrid laptops) -------------------------------------
# On an iGPU+dGPU laptop (this box is AMD iGPU + NVIDIA RTX) gzserver's gpu_ray
# and rviz pick the Mesa/iGPU GLX by default, leaving the RTX idle — the LiDAR
# raycast then runs on the weak iGPU. Verify with:
#   grep -o libGLX_mesa /proc/$(pgrep -x gzserver)/maps   # mesa = iGPU (bad)
#   nvidia-smi          # gzserver absent from the process list = not on dGPU
# Route GL to the NVIDIA card. No-op when there is no NVIDIA GLX vendor.
if [ -e /usr/lib/x86_64-linux-gnu/libGLX_nvidia.so.0 ] && command -v nvidia-smi >/dev/null 2>&1; then
  export __NV_PRIME_RENDER_OFFLOAD="${__NV_PRIME_RENDER_OFFLOAD:-1}"
  export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
  export __VK_LAYER_NV_optimus="${__VK_LAYER_NV_optimus:-NVIDIA_only}"
fi

[ -f "/opt/ros/humble/setup.$_fsk_ext" ] && source "/opt/ros/humble/setup.$_fsk_ext"
[ -f "$EUFS_MASTER/install/setup.$_fsk_ext" ] && source "$EUFS_MASTER/install/setup.$_fsk_ext"

# --- patched gazebo (src/tools/gazebo-patches) --------------------------------
# GPU lidar path: hides SkyX from the laser depth pass (stock gpu_ray returns
# the cloud dome as ~12k phantom points at 17-21 m per scan) and exposes the
# first-pass texture floor. Build once per machine:
#   bash "$EUFS_MASTER/src/tools/gazebo-patches/build-patched-gazebo.sh"
# No-op when the prefix is absent — but then keep the VLP-16R macro's gpu
# param false, or you get the stock artifacts back.
if [ -f "$HOME/opt/gazebo11-fsk/share/gazebo/setup.sh" ]; then
  source "$HOME/opt/gazebo11-fsk/share/gazebo/setup.sh"
  export PATH="$HOME/opt/gazebo11-fsk/bin:$PATH"
  export LD_LIBRARY_PATH="$HOME/opt/gazebo11-fsk/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  # 8192: grazing-ring staircase at the sensor noise floor, ~750 MB VRAM.
  export GAZEBO_GPU_LASER_TEX_MIN="${GAZEBO_GPU_LASER_TEX_MIN:-8192}"
fi

# --- workspace ----------------------------------------------------------------
fskcd() { cd "$EUFS_MASTER"; }
fsb() {
  cd "$EUFS_MASTER" && colcon build --symlink-install --base-paths src "$@" &&
    source "install/setup.$_fsk_ext"
}

# --- run: the 3-step flow ------------------------------------------------------
# Nothing drives until step 3 — the vehicle ignores commands until a mission
# is armed.
#   step 1  race [track] [sim|real] [bg] [norviz]   sim + perception
#           fsk [bg] [rviz]                         vehicle sensors + perception
#   step 2  stack [args]                            INS+SLAM+planning+control (standby)
#   step 3  mission trackdrive [laps=10] | autocross [laps=1]
#           mission skidpad [laps-per-circle=2] | acceleration
#           mission stop (EBS) | reset | status
# Stop everything: race stop | re-attach: race attach
race()    { "$EUFS_MASTER/src/scripts/race.sh" "$@"; }
fsk()     { "$EUFS_MASTER/src/scripts/fsk.sh" "$@"; }
stack()   { "$EUFS_MASTER/src/scripts/stack.sh" "$@"; }
mission() { "$EUFS_MASTER/src/scripts/mission.sh" "$@"; }
simfull() { ros2 launch eufs_launcher simulation.launch.py perception_mode:=sim rviz:=true "$@"; }
pbring()  { ros2 launch hyu_planning_bringup local_global_planning.launch.py "$@"; }
teleop()  { ros2 run hyu_teleop teleop "$@"; }

# --- helpers ------------------------------------------------------------------
resetcar() { ros2 service call /vehicle/reset_vehicle_pos std_srvs/srv/Trigger; }
slamreset(){ ros2 service call /graph_slam/start_mapping std_srvs/srv/Trigger; }
rv()       { rviz2 -d "$EUFS_MASTER/install/eufs_launcher/share/eufs_launcher/config/default.rviz" "$@"; }

unset _fsk_this _fsk_src_dir
