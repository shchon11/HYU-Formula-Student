<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc_controller</name>
  <version>0.1.0</version>
  <description>LTV-MPC drive controller (drop-in replacement for pure pursuit).</description>
  <maintainer email="shchon724@gmail.com">HYU Formula Student</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ackermann_msgs</depend>
  <depend>eufs_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- quadprog: pip dependency (pip install quadprog, user site),
       already required by trajectory_generator; see the workspace README. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
