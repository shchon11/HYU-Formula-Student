<?xml version="1.0"?>
<robot name="zed_camera"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.1415926535897931" />

  <xacro:macro name="zed_camera" params="prefix parent *origin active">

    <joint name="${prefix}_base_joint" type="fixed">
      <axis xyz="1 0 0"/>
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_camera_center"/>
    </joint>


    <link name="${prefix}_camera_center">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find eufs_sensors)/meshes/zed.dae" />
        </geometry>
        <material name="light_grey">
          <color rgba="0.8 0.8 0.8 0.8"/>
        </material>
      </visual>
    </link>


    <!-- Left and right frames -->
    <link name="${prefix}_left_camera_frame"/>

    <link name="${prefix}_right_camera_frame"/>

    <link name="${prefix}_left_camera_optical_frame"/>

    <link name="${prefix}_right_camera_optical_frame"/>

    <joint name="${prefix}_left_camera_joint" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_left_camera_frame"/>
      <origin xyz="0 0.06 0" rpy="0 0 0" />
    </joint>

    <joint name="${prefix}_right_camera_joint" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_right_camera_frame"/>
      <origin xyz="0 -0.06 0" rpy="0 0 0" />
    </joint>

    <joint name="${prefix}_left_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}_left_camera_frame" />
      <child link="${prefix}_left_camera_optical_frame"/>
    </joint>

    <joint name="${prefix}_right_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}_right_camera_frame" />
      <child link="${prefix}_right_camera_optical_frame"/>
    </joint>

    <!-- depth frame -->
    <link name="${prefix}_depth_camera_frame"/>
    <link name="${prefix}_depth_camera_optical_frame"/>

    <joint name="${prefix}_depth_camera" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_depth_camera_frame"/>
      <origin xyz="0 0.06 0" rpy="0 0 0" />
    </joint>

    <joint name="${prefix}_depth_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}_depth_camera_frame" />
      <child link="${prefix}_depth_camera_optical_frame"/>
    </joint>

    <!-- Rates are what the GPU can actually sustain, not an aspiration. At 60 Hz
         the left and right cameras each fell behind by a different amount (measured
         15.2 and 10.6 Hz), so they free-ran on separate schedules and their stamps
         drifted apart. Fusion needs the pair within image_sync_tolerance_sec (50 ms)
         or it drops the stereo tier for that frame, which starved Tier 3. Equal,
         sustainable rates keep both sensors on the same update tick.
         The depth camera is not subscribed by anything in this workspace, so it only
         competed for the GPU; it is kept alive at a token rate. -->
    <!-- Simulate raw perception sensors only if we're not using the abstracted perception simulation -->
    <xacro:unless value="${active}">
      <gazebo reference="${prefix}_left_camera_frame">
        <sensor type="camera" name="${prefix}_left_camera">
          <!-- see MultiSenseSLPlugin.h for available modes -->
          <always_on>true</always_on>
          <update_rate>15.0</update_rate>
          <visualize>true</visualize>
          <camera>
            <pose>0 0.0 0 0 0 0</pose>
            <horizontal_fov>1.91986</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>B8G8R8</format>
            </image>
            <clip>
              <near>0.5</near>
              <far>20</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>

          <plugin name="${prefix}_left_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <parameter name="update_rate" type="double">15.0</parameter>
              <remapping>/${prefix}_left/image_raw:=/${prefix}/left/image_rect_color</remapping>
              <remapping>/${prefix}_left/camera_info:=/${prefix}/left/camera_info</remapping>
              <qos>
                <topic name="/${prefix}/left/image_rect_color">
                  <publisher>
                    <reliability>reliable</reliability>
                  </publisher>
                </topic>
                <topic name="/${prefix}/left/camera_info">
                  <publisher>
                    <reliability>reliable</reliability>
                  </publisher>
                </topic>
              </qos>
            </ros>

            <camera_name>${prefix}_left</camera_name>
            <frame_name>${prefix}_left_camera_optical_frame</frame_name>
            <triggered>false</triggered>
          </plugin>
        </sensor>
      </gazebo>

      <gazebo reference="${prefix}_right_camera_frame">
        <sensor type="camera" name="${prefix}_right_camera">
          <always_on>true</always_on>
          <update_rate>15.0</update_rate>
          <visualize>true</visualize>
          <camera>
            <pose>0 0.0 0 0 0 0</pose>
            <horizontal_fov>1.91986</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>B8G8R8</format>
            </image>
            <clip>
              <near>0.5</near>
              <far>20</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>

          <plugin name="${prefix}_right_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <parameter name="update_rate" type="double">15.0</parameter>
              <remapping>/${prefix}_right/image_raw:=/${prefix}/right/image_rect_color</remapping>
              <remapping>/${prefix}_right/camera_info:=/${prefix}/right/camera_info</remapping>
              <qos>
                <topic name="/${prefix}/right/image_rect_color">
                  <publisher>
                    <reliability>reliable</reliability>
                  </publisher>
                </topic>
                <topic name="/${prefix}/right/camera_info">
                  <publisher>
                    <reliability>reliable</reliability>
                  </publisher>
                </topic>
              </qos>
            </ros>

            <camera_name>${prefix}_right</camera_name>
            <frame_name>${prefix}_right_camera_optical_frame</frame_name>
            <triggered>false</triggered>
          </plugin>
        </sensor>
      </gazebo>

      <gazebo reference="${prefix}_depth_camera_frame">
        <!-- Depth simulation -->
        <sensor name="stereo_depth" type="depth">
          <always_on>true</always_on>
          <update_rate>1.0</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.91986</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>B8G8R8</format>
            </image>
            <depth_camera>
            </depth_camera>
            <clip>
              <near>0.5</near>
              <far>20.0</far>
            </clip>
          </camera>

          <plugin name="${prefix}_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <parameter name="update_rate" type="double">1.0</parameter>
            </ros>

            <camera_name>${prefix}</camera_name>
            <frame_name>${prefix}_depth_camera_optical_frame</frame_name>
            <hack_baseline>0.120</hack_baseline>
            <max_depth>20.0</max_depth>
            <min_depth>0.5</min_depth>
          </plugin>

        </sensor>
      </gazebo>
    </xacro:unless>

  </xacro:macro>
</robot>