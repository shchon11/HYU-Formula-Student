<?xml version="1.0"?>
<robot name="zed_camera"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.1415926535897931" />

  <!-- depth: emit the Gazebo `depth` sensor. Off by default because it costs a
       second full 1280x720 render pass plus a point cloud, competing with the
       left and right cameras for the render thread, and nothing in this
       workspace subscribes to what it produces. See the block itself. -->
  <xacro:macro name="zed_camera" params="prefix parent *origin active depth:=false">

    <joint name="${prefix}_base_joint" type="fixed">
      <axis xyz="1 0 0"/>
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_camera_center"/>
    </joint>


    <link name="${prefix}_camera_center">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find eufs_sensors)/meshes/zed.dae" />
        </geometry>
        <material name="light_grey">
          <color rgba="0.8 0.8 0.8 0.8"/>
        </material>
      </visual>
    </link>


    <!-- Left and right frames -->
    <link name="${prefix}_left_camera_frame"/>

    <link name="${prefix}_right_camera_frame"/>

    <link name="${prefix}_left_camera_optical_frame"/>

    <link name="${prefix}_right_camera_optical_frame"/>

    <joint name="${prefix}_left_camera_joint" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_left_camera_frame"/>
      <origin xyz="0 0.06 0" rpy="0 0 0" />
    </joint>

    <joint name="${prefix}_right_camera_joint" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_right_camera_frame"/>
      <origin xyz="0 -0.06 0" rpy="0 0 0" />
    </joint>

    <joint name="${prefix}_left_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}_left_camera_frame" />
      <child link="${prefix}_left_camera_optical_frame"/>
    </joint>

    <joint name="${prefix}_right_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}_right_camera_frame" />
      <child link="${prefix}_right_camera_optical_frame"/>
    </joint>

    <!-- depth frame -->
    <link name="${prefix}_depth_camera_frame"/>
    <link name="${prefix}_depth_camera_optical_frame"/>

    <joint name="${prefix}_depth_camera" type="fixed">
      <parent link="${prefix}_camera_center"/>
      <child link="${prefix}_depth_camera_frame"/>
      <origin xyz="0 0.06 0" rpy="0 0 0" />
    </joint>

    <joint name="${prefix}_depth_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="${prefix}_depth_camera_frame" />
      <child link="${prefix}_depth_camera_optical_frame"/>
    </joint>

    <!-- 30 Hz, and it is delivered. Read the note about clocks before
         "fixing" this.

         Measured from the message stamps, which is the only clock that matters
         here: left 29.41 Hz, velodyne 10.00 Hz (jitter 0.3 ms), /cones 29.41.
         `ros2 topic hz` reports WALL clock and will show ~24 instead, because
         the sim runs at RTF 0.83. Everything downstream (perception, SLAM,
         planning) runs on sim time, so a sensor firing every 33 ms of SIM time
         is a 30 Hz sensor no matter how long the wall clock takes. A slow RTF
         costs test wall time and nothing else.

         This distinction is not academic. A whole investigation was run against
         wall-clock rates and concluded the cameras "could not reach 15 Hz",
         when they were reaching 15 Hz in sim time the entire time and the RTF
         was 0.6. Sensor rate and RTF are different numbers; `topic hz` gives
         the second one.

         `format` is R8G8B8, not B8G8R8: Ogre renders 32 bit, and asking for a
         24 bit format made it convert 921k pixels per frame ON THE CPU, inside
         the single Ogre GL thread every image sensor shares. Worth ~25 % of RTF
         (left went 19.8 to 25.0 Hz wall). Safe because ros_image_utils reads
         the source encoding off the message and swaps channels, and
         yolov8_bbox_node asks for bgr8 explicitly.

         `__GL_YIELD=USLEEP` in the sim launch environment is also worth having:
         the NVIDIA driver busy waits on the readback sync by default, burning
         the render thread. Making it sleep drops host load ~2.5 to ~1.8.

         Ruled out by measurement, not argument: a faster GPU (it idles at 11 %
         while the render thread is CPU bound at 88 to 92 %), more cores (one
         Ogre GL context binds to one thread, so 14 cores sit idle), compressed
         images and a publish worker thread (publishing costs NOTHING: 139 % CPU
         with no subscribers, 138 % with both image topics subscribed), removing
         the sky (the cameras clip at 20 m and never saw it), and removing the
         camera noise (faster, but the detector trains on FSOCO's real noisy
         images, so a clean sim is an easier sim).

         KNOWN AND OPEN: the right camera settles at 20.00 Hz in sim time while
         the left holds 29.41, and both jitter badly (60 to 100 ms against the
         velodyne's 0.3). The ZNCC cross check needs both images within
         max_image_age_sec or it silently does not run, and it is what removes
         the monocular tier's range bias. Watch its confirm rate. -->
    <!-- Simulate raw perception sensors only if we're not using the abstracted perception simulation -->
    <xacro:unless value="${active}">
      <gazebo reference="${prefix}_left_camera_frame">
        <!-- ONE multicamera sensor, not two camera sensors. This is what makes
             the pair a stereo pair.

             As two independent sensors they each chased their own sim time
             tick, and under load the right one missed every other tick and sat
             at EXACTLY half the left's rate (15.15 against 28.99). Two images
             at different sim instants are not a stereo pair: the disparity
             between them contains the car's motion, not the scene's depth, and
             the ZNCC cross check that removes the monocular tier's range bias
             silently stops running.

             A multicamera sensor renders both children in ONE update, so they
             share a sim time and a stamp by construction rather than by luck.
             Tuning rates could never have fixed this; it is structural. -->
        <sensor type="multicamera" name="${prefix}_stereo_camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <visualize>false</visualize>
          <camera name="left">
            <pose>0 0.06 0 0 0 0</pose>
            <horizontal_fov>1.91986</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.5</near>
              <far>20</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
          <camera name="right">
            <pose>0 -0.06 0 0 0 0</pose>
            <horizontal_fov>1.91986</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.5</near>
              <far>20</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>

          <plugin name="${prefix}_stereo_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>${prefix}/left/image_raw:=${prefix}/left/image_rect_color</remapping>
              <remapping>${prefix}/right/image_raw:=${prefix}/right/image_rect_color</remapping>
            </ros>
            <camera_name>${prefix}</camera_name>
            <frame_name>${prefix}_left_camera_optical_frame</frame_name>
            <hack_baseline>0.12</hack_baseline>
          </plugin>
        </sensor>
      </gazebo>

      <!-- Depth simulation. DISABLED.
           A `depth` sensor costs a full 1280x720 render pass plus a point
           cloud, and nothing subscribes to any of what it emits:
           /zed/depth/image_raw, /zed/points and /zed/image_raw all measured
           zero subscribers with the real perception stack running. The stereo
           tier works from the left and right image_rect_color topics instead.
           The cost is not the 1 Hz it asks for: it competes with the left and
           right cameras for Gazebo's render thread, and those two already miss
           their requested rate (15 Hz asked, ~8.8 Hz achieved), which is what
           starves the bbox/LiDAR pairing downstream.
           Re-enable (always_on true) only if something actually consumes it,
           e.g. if the ZED SDK NEURAL depth option in the roadmap is tried. -->
      <xacro:if value="${depth}">
      <gazebo reference="${prefix}_depth_camera_frame">
        <sensor name="stereo_depth" type="depth">
          <always_on>true</always_on>
          <update_rate>1.0</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.91986</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <depth_camera>
            </depth_camera>
            <clip>
              <near>0.5</near>
              <far>20.0</far>
            </clip>
          </camera>

          <plugin name="${prefix}_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <parameter name="update_rate" type="double">1.0</parameter>
            </ros>

            <camera_name>${prefix}</camera_name>
            <frame_name>${prefix}_depth_camera_optical_frame</frame_name>
            <hack_baseline>0.120</hack_baseline>
            <max_depth>20.0</max_depth>
            <min_depth>0.5</min_depth>
          </plugin>

        </sensor>
      </gazebo>
      </xacro:if>
    </xacro:unless>

  </xacro:macro>
</robot>