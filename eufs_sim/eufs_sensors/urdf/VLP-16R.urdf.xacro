<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="VLP-16">
  <xacro:property name="M_PI" value="3.1415926535897931" />
  <!-- Real VLP-16 spec, not a cheaper approximation of one.

       Horizontal resolution is NOT a free parameter: the Puck fires each laser
       on a fixed interval, so spinning faster spreads the same firings over
       more degrees. The datasheet's table falls straight out of that, and the
       giveaway is that points/second is constant across all three rates:

         5 Hz -> 0.1 deg -> 3600 samples/rev -> 57600 pts/rev -> 288k pts/s
        10 Hz -> 0.2 deg -> 1800 samples/rev -> 28800 pts/rev -> 288k pts/s
        20 Hz -> 0.4 deg ->  900 samples/rev -> 14400 pts/rev -> 288k pts/s

       So `hz` is the only knob, and samples follow: 360/(0.02*hz) = 18000/hz.
       Carrying both independently lets them disagree, which is how ads-dv ended
       up asking for 0.45 deg at 10 Hz, a sensor that does not exist.

       Vertical is fixed by hardware and does not scale with rate: 16 lasers
       over +/-15 deg at 2.0 deg. `lasers` defaulted to 40 here, 2.5x the real
       count, and ads-dv silently took that default.

       This used to be 350 samples over 229 deg = 0.655 deg/ray, which is 3.3x
       coarser than the real sensor and 19 % of its rays. That made the sim
       PESSIMISTIC about far cones in a way the car will not be: a 15 m cone
       gets 5.4 rays from a real Puck and got 1.7 here.

       It costs real time factor, and that is the right trade. Measured: RTF
       0.406, and every sensor still hits its configured rate IN SIM TIME, which
       is the only clock perception, SLAM and planning read: both cameras 29.41
       Hz, velodyne 10.00, /cones 10.00. Wall clock is 2.5x slower and nothing
       downstream can tell. Use scripts/measure_sim_rates.py, not
       `ros2 topic hz`, which reports wall clock and will make this look broken.

       An earlier version of this comment credited the ray count with fixing a
       stereo rate split. There was no split. The "right camera at half rate"
       came from probes that subscribed to both image streams from one Python
       process, which cannot deserialise 2x 2.7 MB at 30 Hz; each camera reads
       29.41 Hz when measured one topic per process. Measure that way. -->
  <xacro:macro
    name="VLP-16R"
    params="*origin parent:=base_footprint
            name:=velodyne active
            topic:=/velodyne_points
            hz:=10
            lasers:=16
            samples:=0
            min_range:=0.2
            max_range:=100.0
            noise:=0.008
            min_angle:=-3.14159265
            max_angle:=3.14159265">

    <!-- samples=0 means "be a real Puck at this rate". A non-zero value is an
         explicit, knowing departure from the datasheet, not a default. -->
    <xacro:property name="h_samples"
                    value="${int(round(18000.0 / hz)) if samples == 0 else samples}"/>
    <xacro:property name="h_res_deg" value="${360.0 / h_samples}"/>

    <joint name="${name}_base_mount_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${name}_base_link"/>
    </joint>

    <link name="${name}_base_link">
      <inertial>
        <mass value="0.83"/>
        <origin xyz="0 0 0.03585"/>
        <inertia ixx="${(0.83 * (3.0*0.0516*0.0516 + 0.0717*0.0717)) / 12.0}" ixy="0" ixz="0"
          iyy="${(0.83 * (3.0*0.0516*0.0516 + 0.0717*0.0717)) / 12.0}" iyz="0"
          izz="${0.5 * 0.83 * (0.0516*0.0516)}"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find eufs_sensors)/meshes/VLP16_base_1.dae" />
        </geometry>
      </visual>
      <visual>
        <geometry>
          <mesh filename="file://$(find eufs_sensors)/meshes/VLP16_base_2.dae" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.03585"/>
        <geometry>
          <cylinder radius="0.0516" length="0.0717"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_base_scan_joint" type="fixed" >
      <origin xyz="0 0 0.0377" rpy="0 0 0" />
      <parent link="${name}_base_link" />
      <child link="${name}"/>
    </joint>

    <link name="${name}">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.0377" />
        <geometry>
          <mesh filename="file://$(find eufs_sensors)/meshes/VLP16_scan.dae" />
        </geometry>
      </visual>
    </link>

    <!-- Simulate raw perception sensors only if we're not using the abstracted perception simulation -->
    <xacro:unless value="${active}">
      <!-- Gazebo requires the velodyne_gazebo_plugins package -->
      <gazebo reference="${name}">
        <sensor type="ray" name="${name}-VLP16">
          <always_on>true</always_on>
          <pose>0 0 0 0 0 0</pose>
          <visualize>false</visualize>
          <update_rate>${hz}</update_rate>
          <ray>
            <scan>
              <!-- ${h_samples} samples/rev = ${h_res_deg} deg at ${hz} Hz -->
              <horizontal>
                <samples>${h_samples}</samples>
                <resolution>1.0</resolution>
                <min_angle>${min_angle}</min_angle>
                <max_angle>${max_angle}</max_angle>
              </horizontal>
              <vertical>
                <samples>${lasers}</samples>
                <resolution>1.0</resolution>
                <min_angle>-${15.0*M_PI/180.0}</min_angle>
                <max_angle> ${15.0*M_PI/180.0}</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${min_range}</min>
              <max>${max_range}</max>
              <resolution>0.001</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>${noise}</stddev>
            </noise>
          </ray>

          <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <remapping>~/out:=${topic}</remapping>
            </ros>
            <frame_name>${name}</frame_name>
            <radiation_type>infrared</radiation_type>
            <output_type>sensor_msgs/PointCloud2</output_type>
          </plugin>

        </sensor>
      </gazebo>
    </xacro:unless>

  </xacro:macro>
</robot>
