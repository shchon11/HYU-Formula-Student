<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='big_cone'>
    <link name='link'>
      <pose frame=''>0 0 0 0 0 0</pose>
      <inertial>
        <inertia>
          <ixx>0.0016</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0016</iyy>
          <iyz>0</iyz>
          <izz>0.0010</izz>
        </inertia>
        <mass>0.45</mass>
      </inertial>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>file://cone_big.dae</uri>
          </mesh>
        </geometry>
        <cast_shadows>1</cast_shadows>
      </visual>
      <!-- Collision is a primitive, not the visual mesh (see blue_cone). The
           mesh node matrix (Y-up, scale 0.00655834) puts the origin at the
           BASE: footprint r~0.131, z 0.002..0.528 -> cylinder centered 0.265. -->
      <collision name='collision'>
        <max_contacts>3</max_contacts>
        <pose>0 0 0.265 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.131</radius>
            <length>0.5255</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>