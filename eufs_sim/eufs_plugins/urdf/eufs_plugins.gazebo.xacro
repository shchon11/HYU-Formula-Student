<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="publish_tf" default="false"/>
  <xacro:arg name="simulate_perception" default="false"/>
  <xacro:arg name="command_mode" default="acceleration"/>
  <xacro:arg name="pub_ground_truth" default="true"/>
  <xacro:arg name="perception_camera_view_distance" default="12"/>
  <xacro:arg name="perception_lidar_view_distance" default="15"/>
  <xacro:arg name="perception_lidar_x_view_distance" default="15"/>
  <xacro:arg name="perception_lidar_y_view_distance" default="10"/>
  <xacro:arg name="perception_lidar_min_view_distance" default="1"/>
  <xacro:arg name="perception_camera_min_view_distance" default="0.5"/>
  <xacro:arg name="perception_camera_fov" default="1.91986"/>
  <xacro:arg name="perception_lidar_fov" default="3.141593"/>
  <xacro:arg name="perception_lidar_on" default="true"/>
  <xacro:arg name="perception_detection_probability" default="1.0"/>
  <!-- 0.0 = lidar-accurate cone positions (the real pipeline takes positions
       from lidar clustering; the camera only classifies color). Raise toward
       1.0 to simulate camera-depth-dominant noise instead. -->
  <xacro:arg name="perception_camera_noise_percentage" default="0.0"/>
  <xacro:arg name="camera_cones_view_distance" default="13"/>
  <xacro:arg name="camera_cones_min_view_distance" default="0.5"/>
  <xacro:arg name="camera_cones_fov" default="2.09"/>
  <xacro:arg name="camera_cones_detection_probability" default="1.0"/>
  <!-- Road-roughness vibration. On by default (unchanged behaviour), but it is
       the loudest thing on the body attitude at speed, so turn it off to observe
       the car's own physics. -->
  <xacro:arg name="road_noise" default="true"/>
  <!-- Procedural bump field; off by default so existing runs are unchanged. -->
  <xacro:arg name="terrain" default="false"/>
  <xacro:arg name="terrain_seed" default="7"/>
  <xacro:arg name="terrain_density" default="0.02"/>
  <xacro:arg name="terrain_height_mean" default="0.020"/>

  <!-- Custom plugin which controls the car using a given vehicle model.
   It controls the car by setting its velocity and position
   and the steering angle of the wheels -->
  <gazebo>
    <plugin name="race_car" filename="libgazebo_race_car_model.so">
      <update_rate>1000.0</update_rate>
      <publish_rate>200.0</publish_rate>
      <vehicle_model>$(arg vehicle_model)</vehicle_model>
      <front_left_wheel_steering>left_steering_hinge_joint</front_left_wheel_steering>
      <front_right_wheel_steering>right_steering_hinge_joint</front_right_wheel_steering>
      <front_left_wheel>front_left_wheel_joint</front_left_wheel>
      <front_right_wheel>front_right_wheel_joint</front_right_wheel>
      <rear_left_wheel>rear_left_wheel_joint</rear_left_wheel>
      <rear_right_wheel>rear_right_wheel_joint</rear_right_wheel>
      <yaml_config>$(arg config_file)</yaml_config>
      <noise_config>$(arg noise_config)</noise_config>
      <referenceFrame>map</referenceFrame>
      <robotFrame>base_footprint</robotFrame>
      <publishTransform>$(arg publish_tf)</publishTransform>
      <groundTruthCarStateTopic>/ground_truth/state</groundTruthCarStateTopic>
      <localisationCarStateTopic>/odometry_integration/car_state</localisationCarStateTopic>
      <!-- The synthetic localisation car state is a sim-only stand-in that the
           real car never publishes. The stack runs the simulated INS pipeline
           instead (sim_ellipse_d -> sbg bridge -> /gnss/odom anchor, wheel
           odometry -> /wheel_odometry/car_state motion), so it is disabled to
           keep anything from silently depending on it. -->
      <publishLocalisationCarState>false</publishLocalisationCarState>
      <!-- Drifting odometry for the localisation car state (GT stays on
           groundTruthCarStateTopic). Set driftOdometry to false to restore the
           noise-model behaviour. -->
      <driftOdometry>true</driftOdometry>
      <driftVelocityBias>0.02</driftVelocityBias>
      <driftYawRateBias>0.01</driftYawRateBias>
      <driftVelocityNoise>0.05</driftVelocityNoise>
      <driftYawRateNoise>0.01</driftYawRateNoise>
      <!-- Continuous road-roughness vibration on the car body. The car bounces
           (z) and rocks (roll/pitch) with an amplitude that scales with speed,
           so the rigidly-attached IMU/camera/LiDAR feel it too. Set roadNoise
           to false to keep the car perfectly flat. -->
      <roadNoise>$(arg road_noise)</roadNoise>
      <roadNoiseZ>0.010</roadNoiseZ><!-- vertical bounce stddev [m] at v_ref -->
      <roadNoiseRoll>0.006</roadNoiseRoll><!-- roll stddev [rad] at v_ref -->
      <roadNoisePitch>0.006</roadNoisePitch><!-- pitch stddev [rad] at v_ref -->
      <roadNoiseCorrelation>0.05</roadNoiseCorrelation><!-- correlation time [s] -->
      <roadNoiseSpeedRef>5.0</roadNoiseSpeedRef><!-- speed [m/s] for nominal amplitude -->
      <roadNoiseMaxGain>2.0</roadNoiseMaxGain><!-- cap on speed amplitude gain -->
      <!-- Acceleration load transfer: longitudinal accel pitches the body
           (accel = nose up, braking = dive), lateral accel rolls it outward in
           a corner. How far it leans and how it gets there are properties of the
           car, so they live in its vehicle config (the `suspension:` block in
           robots/[car]/config*.yaml) alongside its mass and tyres, including
           `load_transfer_to_tires`, which couples the transfer into tyre grip.
           Only the safety clamps are here. -->
      <loadTransfer>true</loadTransfer>
      <loadTransferMaxRoll>0.12</loadTransferMaxRoll><!-- clamp [rad] (~6.9 deg) -->
      <loadTransferMaxPitch>0.12</loadTransferMaxPitch><!-- clamp [rad] -->
      <!-- Procedural bump field. Unlike roadNoise above, these are real geometry
           inserted into the world: the LiDAR ray-traces them and the cameras see
           them, and the car's z/roll/pitch come from the terrain height under
           each wheel, so the bump in the point cloud is the bump the car climbs.
           Bumps are a function of position, so the same seed is the same track
           every run and driving a line twice hits the same bumps twice.
           Defaults are gentle asphalt undulation (~2 cm). Raise terrainHeightMean
           to stress ground-plane RANSAC and the INS; set terrain false for the
           perfectly flat floor. -->
      <terrain>$(arg terrain)</terrain>
      <terrainSeed>$(arg terrain_seed)</terrainSeed>
      <terrainDensity>$(arg terrain_density)</terrainDensity><!-- bumps per m^2 -->
      <terrainHeightMean>$(arg terrain_height_mean)</terrainHeightMean><!-- peak height [m] -->
      <terrainHeightSigma>0.010</terrainHeightSigma><!-- height stddev [m] -->
      <terrainHeightMin>0.004</terrainHeightMin><!-- floor on the height draw [m] -->
      <terrainRadiusMin>0.25</terrainRadiusMin><!-- footprint radius [m] -->
      <terrainRadiusMax>0.60</terrainRadiusMax>
      <!-- Bumps are grown within this distance of a track cone: the car only
           drives between the cones, so that is the only ground a bump can
           matter on, and covering the rest costs thousands of them for nothing. -->
      <terrainTrackMargin>3.5</terrainTrackMargin><!-- [m] from any cone -->
      <terrainMaxBumps>600</terrainMaxBumps><!-- refuse to build a world that kills gzserver -->
      <!-- Fallback area, used only if the world has no 'track' model. -->
      <terrainHalfExtentX>60.0</terrainHalfExtentX>
      <terrainHalfExtentY>60.0</terrainHalfExtentY>
      <wheelSpeedsTopicName>/ros_can/wheel_speeds</wheelSpeedsTopicName>
      <groundTruthWheelSpeedsTopicName>/ground_truth/wheel_speeds</groundTruthWheelSpeedsTopicName>
      <jointStatesTopicName>/eufs/joint_states</jointStatesTopicName>
      <odometryTopicName>/ground_truth/odom</odometryTopicName>
      <commandMode>$(arg command_mode)</commandMode>
      <controlDelay>0.2</controlDelay>
      <!-- The time in seconds it takes for the car to go from lock to lock -->
      <steeringLockTime>1</steeringLockTime>
      <pubGroundTruth>$(arg pub_ground_truth)</pubGroundTruth>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gz_ground_truth_cones" filename="libgazebo_ground_truth_cones.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>20.0</updateRate>
      <cameraViewDistance>$(arg perception_camera_view_distance)</cameraViewDistance>
      <lidarViewDistance>$(arg perception_lidar_view_distance)</lidarViewDistance>
      <lidarXViewDistance>$(arg perception_lidar_x_view_distance)</lidarXViewDistance>
      <lidarYViewDistance>$(arg perception_lidar_y_view_distance)</lidarYViewDistance>
      <lidarMinViewDistance>$(arg perception_lidar_min_view_distance)</lidarMinViewDistance>
      <cameraFOV>$(arg perception_camera_fov)</cameraFOV><!-- radians -->
      <cameraMinViewDistance>$(arg perception_camera_min_view_distance)</cameraMinViewDistance>
      <lidarFOV>$(arg perception_lidar_fov)</lidarFOV><!-- radians -->
      <lidarOn>$(arg perception_lidar_on)</lidarOn><!--If false, we only simulate camera measurements-->
      <trackFrame>map</trackFrame>
      <recolor_config>$(arg recolor_config)</recolor_config>
      <groundTruthConesTopicName>/ground_truth/cones</groundTruthConesTopicName>
      <groundTruthTrackTopicName>/ground_truth/track</groundTruthTrackTopicName>
      <simulatePerception>$(arg simulate_perception)</simulatePerception>
      <perceptionConesTopicName>/cones</perceptionConesTopicName>
      <detectionProbability>$(arg perception_detection_probability)</detectionProbability>
      <perceptionCameraNoisePercentage>$(arg perception_camera_noise_percentage)</perceptionCameraNoisePercentage>
      <perceptionCameraDepthNoiseParameterA>0.01</perceptionCameraDepthNoiseParameterA>
      <perceptionCameraDepthNoiseParameterB>0.5</perceptionCameraDepthNoiseParameterB>
      <perceptionLidarNoise>0.03 0.03 0.0</perceptionLidarNoise>
      <pubGroundTruth>$(arg pub_ground_truth)</pubGroundTruth>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gz_camera_0_cones" filename="libgazebo_camera_cones.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>15.0</updateRate>
      <cameraViewDistance>$(arg camera_cones_view_distance)</cameraViewDistance>
      <cameraFOV>$(arg camera_cones_fov)</cameraFOV><!-- radians -->
      <cameraMinViewDistance>$(arg camera_cones_min_view_distance)</cameraMinViewDistance>
      <cameraTF>0.204 0.074 0.706 0 0 0.79</cameraTF>
      <recolorConfig>cone_recolor.yaml</recolorConfig>
      <cameraConesTopicName>/camera_0/cones</cameraConesTopicName>
      <detectionProbability>$(arg camera_cones_detection_probability)</detectionProbability>
      <perceptionCameraDepthNoiseParameterA>0.01</perceptionCameraDepthNoiseParameterA>
      <perceptionCameraDepthNoiseParameterB>0.5</perceptionCameraDepthNoiseParameterB>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gz_camera_1_cones" filename="libgazebo_camera_cones.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>15.0</updateRate>
      <cameraViewDistance>$(arg camera_cones_view_distance)</cameraViewDistance>
      <cameraFOV>$(arg camera_cones_fov)</cameraFOV><!-- radians -->
      <cameraMinViewDistance>$(arg camera_cones_min_view_distance)</cameraMinViewDistance>
      <cameraTF>0.204 -0.074 0.706 0.0 0.0 -0.79</cameraTF>
      <recolorConfig>cone_recolor.yaml</recolorConfig>
      <cameraConesTopicName>/camera_1/cones</cameraConesTopicName>
      <detectionProbability>$(arg camera_cones_detection_probability)</detectionProbability>
      <perceptionCameraDepthNoiseParameterA>0.01</perceptionCameraDepthNoiseParameterA>
      <perceptionCameraDepthNoiseParameterB>0.5</perceptionCameraDepthNoiseParameterB>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gz_bounding_boxes" filename="libgazebo_simulate_bounding_boxes.so">
      <config_file>$(arg bounding_box_settings)</config_file>
      <publish_rate>50.0</publish_rate>
      <targetFrame>zed_right_camera_optical_frame</targetFrame>
      <sourceFrame>base_footprint</sourceFrame>
      <cameraWidth>1280</cameraWidth>
      <cameraHeight>720</cameraHeight>
      <gtBoundingBoxesTopic>ground_truth/bounding_boxes</gtBoundingBoxesTopic>
      <noisyBoundingBoxesTopic>noisy_bounding_boxes</noisyBoundingBoxesTopic>
      <customCameraInfo>custom_camera_info</customCameraInfo>
    </plugin>
  </gazebo>

</robot>
