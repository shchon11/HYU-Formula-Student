<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyu_sensor_bringup</name>
  <version>0.1.0</version>
  <description>Vehicle sensor bringup: LiDAR + ZED + SBG under /sensors, and the mount/extrinsic TF chain.</description>
  <maintainer email="maintainer@example.com">fsk</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- vcs import src < src/external.repos brings these in -->
  <exec_depend>rslidar_sdk</exec_depend>
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>sbg_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
